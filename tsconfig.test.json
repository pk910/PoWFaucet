{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "dist-test"
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  // The client-side entries of the one module that lived here went with it: the specs that
  // reached into those modules are the module's own tests now, and so
  // is the compiler config that has to name them (a spec's dynamic import is invisible to tsc, so
  // whichever config compiles those specs has to list them). This one is the core's: `src` and the
  // tests that are left.
  "exclude": [
    "node_modules",
    "dist",
    "dist-test",
    "coverage"
  ]
}