{
  "name": "@powfaucet/server",
  "version": "2.5.2",
  "description": "PoW Faucet Server",
  "main": "dist/app.js",
  "bin": {
    "powfaucet": "bundle/powfaucet.cjs"
  },
  "type": "module",
  "files": [
    "dist",
    "bundle",
    "static",
    "libs",
    "faucet-config.example.yaml",
    "README.md",
    "LICENSE",
    "sdk-dist"
  ],
  "exports": {
    ".": "./dist/app.js",
    "./sdk": {
      "types": "./sdk-dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/module": {
      "types": "./sdk-dist/sdk/modulePackage.d.ts",
      "default": "./dist/sdk/modulePackage.js"
    },
    "./sdk/testing": {
      "types": "./sdk-dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-modules.mjs dist/modules",
    "build-client": "cd faucet-client && node build-client.js",
    "sdk": "rm -rf sdk-dist && tsc -p tsconfig.sdk.json && node scripts/sdk-package.mjs",
    "start": "tsc && node dist/app.js",
    "bundle": "tsc && webpack --mode production && node scripts/copy-modules.mjs bundle/modules",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && cp -r libs dist-test/ && cp -r static dist-test/ && NODE_OPTIONS='--experimental-vm-modules' NODE_NO_WARNINGS=1 npx mocha --exit 'dist-test/tests/**/*.js'",
    "test-coverage": "rm -rf dist-test && tsc -p tsconfig.test.json && cp -r libs dist-test/ && cp -r static dist-test/ && NODE_OPTIONS='--experimental-vm-modules' NODE_NO_WARNINGS=1 npx c8 --reporter=text --reporter=lcov npx mocha --exit 'dist-test/tests/**/*.js'",
    "test-browser": "rm -rf dist-test && tsc -p tsconfig.test.json && cp -r libs dist-test/ && cp -r static dist-test/ && FAUCET_E2E_BROWSER=1 NODE_OPTIONS='--experimental-vm-modules' NODE_NO_WARNINGS=1 npx mocha --exit 'dist-test/tests/client/**/*.js' 'dist-test/tests/loader/ModuleClient.spec.js'",
    "modules": "node scripts/copy-modules.mjs dist/modules"
  },
  "author": "pk910 (https://pk910.de)",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pk910/PoWFaucet"
  },
  "pkg": {
    "scripts": "bundle/*.cjs",
    "assets": [
      "faucet-config.example.yaml",
      "static/**/*",
      "bundle/modules/**/*"
    ],
    "targets": [
      "node24-linux-x64",
      "node24-win-x64"
    ],
    "outputPath": "bin"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5",
      "minimatch": "^10.2.4"
    },
    "brace-expansion@1": "^1.1.21"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/chai": "^5.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/mocha": "^10.0.7",
    "@types/mysql": "^2.15.26",
    "@types/node-fetch": "^2.6.11",
    "@types/node-static": "^0.7.11",
    "@types/sinon": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.12",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "mocha": "^12.0.2",
    "mysql-memory-server": "^1.3.0",
    "playwright": "^1.63.0",
    "sinon": "^22.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "webpack": "^5.105.3",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@brettz9/node-static": "^0.1.1",
    "@types/node": "^26.0.0",
    "bignumber.js": "^11.0.0",
    "commander": "^15.0.0",
    "hcaptcha": "^0.2.0",
    "html-entities": "^2.5.2",
    "jose": "^6.2.3",
    "json-bigint": "^1.0.0",
    "mysql2": "^3.11.0",
    "node-fetch": "^3.3.2",
    "tiny-typed-emitter": "^2.1.0",
    "uuid": "^14.0.0",
    "viem": "^2.57.7",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  }
}
